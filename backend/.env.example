APP_NAME="STIKOM Tunas Bangsa"
APP_ENV=local
APP_KEY=
# PENTING (keamanan): set APP_DEBUG=false di environment production/staging.
# Kalau true, error Laravel menampilkan stack trace + isi .env ke publik.
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# BUG YANG DIPERBAIKI: .env.example sempat tertimpa jadi boilerplate default
# `laravel new` (DB_CONNECTION=sqlite) -- proyek ini didesain untuk MySQL sejak
# analisis skema `stikomtb-main` paling awal. Kalau file .env dibuat langsung
# dari versi sqlite tanpa disadari, migrasi & seeder akan tetap "berhasil"
# tapi ke database yang salah / tidak sesuai desain (ENUM, dst).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=stikomtb-main
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MAIL_MAILER=log
MAIL_FROM_ADDRESS="admissions@stikomtb.ac.id"
MAIL_FROM_NAME="${APP_NAME}"

# BUG YANG DIPERBAIKI: variabel ini sebelumnya HILANG TOTAL dari .env.example.
# config/cors.php membaca FRONTEND_URL (fallback ke localhost:5173 kalau tidak
# ada) -- tanpa baris ini di sini, siapa pun yang setup ulang proyek dari nol
# tidak tahu variabel ini perlu diisi ke domain frontend production yang benar,
# dan CORS bisa diam-diam salah konfigurasi di deployment nyata.
FRONTEND_URL=http://localhost:5173

# BUG YANG DIPERBAIKI: sama seperti di atas, variabel ini hilang dari
# .env.example (walau config/sanctum.php sudah membacanya sejak awal) --
# tanpa didokumentasikan di sini, token admin CMS tidak pernah kedaluwarsa di
# setup baru manapun. Nilai dalam MENIT (720 = 12 jam).
SANCTUM_TOKEN_EXPIRATION=720

VITE_APP_NAME="${APP_NAME}"
