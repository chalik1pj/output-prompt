# ============================================================
# Environment Production — STIKOM Tunas Bangsa
# ============================================================
# INSTRUKSI:
#   1. Copy file ini ke .env.production
#      cp .env.production.example .env.production
#   2. Isi semua nilai yang bertanda <GANTI_INI>
#   3. Generate APP_KEY:
#      docker compose exec app php artisan key:generate --show
#      lalu paste hasilnya ke APP_KEY di bawah
# ============================================================

# ── Aplikasi ─────────────────────────────────────────────────
APP_NAME="STIKOM Tunas Bangsa"
APP_ENV=production
APP_KEY=<GANTI_INI>
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
APP_URL=https://stikomtunasbangsa.ac.id

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_MAINTENANCE_DRIVER=file

# ── Database (harus cocok dengan docker-compose.yml) ─────────
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=stikomtb-main
DB_USERNAME=stikomtb
DB_PASSWORD=<GANTI_INI_PASSWORD_KUAT>
DB_ROOT_PASSWORD=<GANTI_INI_ROOT_PASSWORD_KUAT>

# ── Security ─────────────────────────────────────────────────
BCRYPT_ROUNDS=12

# ── Logging ──────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ── CORS & Frontend ─────────────────────────────────────────
FRONTEND_URL=https://stikomtunasbangsa.ac.id

# ── Auth (Sanctum) ───────────────────────────────────────────
# Token admin CMS kedaluwarsa dalam menit (720 = 12 jam)
SANCTUM_TOKEN_EXPIRATION=720

# ── Session ──────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=stikomtunasbangsa.ac.id

# ── Services ─────────────────────────────────────────────────
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
CACHE_PREFIX=stikomtb_

# ── Mail (konfigurasi sesuai mail server kampus) ─────────────
MAIL_MAILER=smtp
MAIL_HOST=<GANTI_INI>
MAIL_PORT=587
MAIL_USERNAME=<GANTI_INI>
MAIL_PASSWORD=<GANTI_INI>
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="admissions@stikomtb.ac.id"
MAIL_FROM_NAME="${APP_NAME}"

# ── Vite ─────────────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"
